<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>College Portal Backend</display-name>


    <servlet>
        <servlet-name>CheckConnection</servlet-name>
        <servlet-class>servlets.CheckConnection</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CheckConnection</servlet-name>
        <url-pattern>/check</url-pattern>
    </servlet-mapping>

<!--LoginServlet-->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlets.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

<!--    registerServlet-->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>servlets.RegisterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>


<!--    AddBookServlet-->
    <servlet>
        <servlet-name>AddBookServlet</servlet-name>
        <servlet-class>servlets.AddBookServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddBookServlet</servlet-name>
        <url-pattern>/addBook</url-pattern>
    </servlet-mapping>


<!--    DeleteBookServlet-->
    <servlet>
        <servlet-name>DeleteBookServlet</servlet-name>
        <servlet-class>servlets.DeleteBookServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DeleteBookServlet</servlet-name>
        <url-pattern>/delete</url-pattern>
    </servlet-mapping>


<!--    GetAllBooksServlet-->
    <servlet>
        <servlet-name>GetAllBooksServlet</servlet-name>
        <servlet-class>servlets.GetAllBooksServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>GetAllBooksServlet</servlet-name>
        <url-pattern>/getBooks</url-pattern>
    </servlet-mapping>


<!--    SearchBooksServlet-->
    <servlet>
        <servlet-name>SearchBooksServlet</servlet-name>
        <servlet-class>servlets.SearchBooksServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SearchBooksServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

<!--    UpdateBookServlet-->
    <servlet>
        <servlet-name>UpdateBookServlet</servlet-name>
        <servlet-class>servlets.UpdateBookServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UpdateBookServlet</servlet-name>
        <url-pattern>/update</url-pattern>
    </servlet-mapping>

<!--SessionManagementServlet-->

    <servlet>
        <servlet-name>SessionManagementServlet</servlet-name>
        <servlet-class>servlets.SessionManagementServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SessionManagementServlet</servlet-name>
        <url-pattern>/getSession</url-pattern>
    </servlet-mapping>


<!--BorrowBookServlet-->
    <servlet>
        <servlet-name>BorrowBookServlet</servlet-name>
        <servlet-class>servlets.BorrowBookServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>BorrowBookServlet</servlet-name>
        <url-pattern>/borrowBook</url-pattern>
    </servlet-mapping>


<!--    ReturnBookServlet-->

    <servlet>
        <servlet-name>ReturnBookServlet</servlet-name>
        <servlet-class>servlets.ReturnBookServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ReturnBookServlet</servlet-name>
        <url-pattern>/returnBook</url-pattern>
    </servlet-mapping>

<!--    GetBorrowedBookServlet-->

    <servlet>
        <servlet-name>GetBorrowedBookServlet</servlet-name>
        <servlet-class>servlets.GetBorrowedBookServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>GetBorrowedBookServlet</servlet-name>
        <url-pattern>/getBorrowedBook</url-pattern>
    </servlet-mapping>

</web-app>